load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//userland/native/system:defs.bzl", "native_system")

package(default_visibility = ["//visibility:public"])

[
    genrule(
        name = "objects_" + arch,
        srcs = [
            "build_dash.py", "test_main.c", "//src/Applications/dash/0.5.13.5:sources",
            "//src/Kernel/Extensions/25.5.0:hfs/core/hfs_mount.h",
            "//userland/native:sdk_" + arch,
        ],
        outs = ["dash." + arch + ".a", "dash." + arch + ".exports", "dash." + arch + ".json",
                "test_main." + arch + ".o", "shell." + arch + ".exports"],
        cmd = "python3 userland/apps/dash/build_dash.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --output $(location dash." + arch + ".a)" +
              " --exports $(location dash." + arch + ".exports)" +
              " --probe-output $(location test_main." + arch + ".o)" +
              " --system-exports $(location shell." + arch + ".exports)" +
              " --report $(location dash." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

filegroup(name = "objects", srcs = [":objects_arm64", ":objects_x86_64"])

[
    native_system(
        name = "system_" + arch,
        arch = arch,
        exports = ":shell." + arch + ".exports",
        libraries = {"accounts": "//userland/native/accounts:libaccounts." + arch + ".a"},
    )
    for arch in ["arm64", "x86_64"]
]

filegroup(name = "systems", srcs = [":system_arm64", ":system_x86_64"])

[
    genrule(
        name = "test_root_" + arch,
        srcs = [
            "build_test.py", "test.sh", ":dash." + arch + ".a", ":test_main." + arch + ".o",
            ":system_" + arch + ".tar", "//userland/native:dyld_" + arch,
            "//userland/diagnostic:root_" + arch,
            "//scripts:native_components.py", "//scripts:build_diagnostic_userland.py",
            "//scripts:sign_diagnostic_macho.py",
        ],
        tools = ["//tools/libdmg-hfsplus:hfsplus"],
        outs = ["shell-test-root." + arch + ".img", "shell-test-root." + arch + ".json"],
        cmd = "python3 userland/apps/dash/build_test.py --root $$PWD --arch " + arch +
              " --base-root $(location //userland/diagnostic:root_" + arch + ")" +
              " --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --system $(location :system_" + arch + ".tar)" +
              " --dash $(location :dash." + arch + ".a)" +
              " --probe $(location :test_main." + arch + ".o)" +
              " --hfs-tool $(location //tools/libdmg-hfsplus:hfsplus)" +
              " --output $(location shell-test-root." + arch + ".img)" +
              " --report $(location shell-test-root." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

filegroup(name = "test_roots", srcs = [":test_root_arm64", ":test_root_x86_64"])

[
    sh_binary(
        name = "verify_" + arch,
        srcs = ["verify.sh"],
        args = [arch],
        data = [":test_root_" + arch, "//:" + arch, "//scripts:verify_qemu_boot.py"],
    )
    for arch in ["arm64", "x86_64"]
]
