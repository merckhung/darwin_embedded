load("//userland/native/system:defs.bzl", "native_system")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

[
    genrule(
        name = "libraries_" + arch,
        srcs = ["build_libraries.py", "//scripts:native_components.py", "//src/Applications/graphics:sources",
                "//userland/native:sdk_" + arch],
        outs = ["libraries." + arch + suffix for suffix in [".tar", ".headers.tar", ".imports", ".json"]],
        cmd = "python3 userland/apps/graphics/build_libraries.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --output $(location libraries." + arch + ".tar)" +
              " --headers $(location libraries." + arch + ".headers.tar)" +
              " --imports $(location libraries." + arch + ".imports)" +
              " --report $(location libraries." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

filegroup(name = "libraries", srcs = [":libraries_arm64", ":libraries_x86_64"])

[
    native_system(name = "system_" + arch, arch = arch, exports = ":libraries." + arch + ".imports",
                  libraries = {"filesystem": "//userland/apps/x11:libnative_x11_support." + arch + ".a"})
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "closure", srcs = [":system_arm64", ":system_x86_64"])

[
    genrule(
        name = "runtime_" + arch,
        srcs = ["link_libraries.py", "build_libraries.py", "//userland/apps/x11:link_auth.py",
                "//scripts:native_components.py", "//scripts:sign_diagnostic_macho.py",
                "//src/Applications/graphics:sources", ":libraries." + arch + ".tar",
                ":system_" + arch + ".tar", "//userland/native:dyld_" + arch],
        outs = ["runtime." + arch + ".tar", "runtime." + arch + ".json"],
        cmd = "python3 userland/apps/graphics/link_libraries.py --root $$PWD --arch " + arch +
              " --libraries $(location :libraries." + arch + ".tar) --system $(location :system_" + arch + ".tar)" +
              " --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --output $(location runtime." + arch + ".tar) --report $(location runtime." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "runtime", srcs = [":runtime_arm64", ":runtime_x86_64"])

sh_test(
    name = "artifact_test",
    size = "small",
    srcs = ["check_libraries.sh"],
    data = ["check_libraries.py", ":libraries", ":runtime", "//src/Applications/graphics:sources",
            "//userland/apps/x11:check_clients.py", "//userland/apps/x11:link_auth.py",
            "//userland/native:dyld_arm64", "//userland/native:dyld_x86_64"],
)

[
    genrule(
        name = "probe_" + arch,
        srcs = ["build_test.py", "build_libraries.py", "test_graphics.c", "//userland/apps/x11:link_auth.py",
                "//scripts:native_components.py", "//scripts:build_diagnostic_userland.py",
                "//scripts:sign_diagnostic_macho.py", ":libraries." + arch + ".tar", "//userland/native:sdk_" + arch],
        outs = ["probe." + arch + ".o", "probe." + arch + ".imports", "probe." + arch + ".json"],
        cmd = "python3 userland/apps/graphics/build_test.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --libraries $(location :libraries." + arch + ".tar)" +
              " --output $(location probe." + arch + ".o) --exports $(location probe." + arch + ".imports)" +
              " --report $(location probe." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

[
    genrule(
        name = "test_imports_" + arch,
        srcs = [":libraries." + arch + ".imports", ":probe." + arch + ".imports",
                "//userland/apps/init:system." + arch + ".exports"],
        outs = ["test." + arch + ".imports"],
        cmd = "cat $(SRCS) > $@",
    )
    for arch in ["arm64", "x86_64"]
]

[
    native_system(name = "test_system_" + arch, arch = arch, exports = ":test." + arch + ".imports",
                  libraries = {"filesystem": "//userland/apps/x11:libnative_x11_support." + arch + ".a",
                               "accounts": "//userland/native/accounts:libaccounts." + arch + ".a"})
    for arch in ["arm64", "x86_64"]
]

[
    genrule(
        name = "test_root_" + arch,
        srcs = ["build_test.py", "build_libraries.py", "//userland/apps/x11:link_auth.py",
                "//scripts:native_components.py", "//scripts:build_diagnostic_userland.py", "//scripts:sign_diagnostic_macho.py",
                "//src/Applications/graphics:sources", ":probe." + arch + ".o", ":runtime." + arch + ".tar",
                ":test_system_" + arch + ".tar", "//userland/apps/init:root_" + arch,
                "//userland/native:dyld_" + arch, "//userland/native:sdk_" + arch],
        tools = ["//tools/libdmg-hfsplus:hfsplus"],
        outs = ["test-root." + arch + ".img", "test-root." + arch + ".json"],
        cmd = "python3 userland/apps/graphics/build_test.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ") --probe $(location :probe." + arch + ".o)" +
              " --runtime $(location :runtime." + arch + ".tar) --system $(location :test_system_" + arch + ".tar)" +
              " --base-root $(location //userland/apps/init:root_" + arch + ")" +
              " --dyld $(location //userland/native:dyld_" + arch + ") --hfs-tool $(location //tools/libdmg-hfsplus:hfsplus)" +
              " --output $(location test-root." + arch + ".img) --report $(location test-root." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "test_roots", srcs = [":test_root_arm64", ":test_root_x86_64"])

[
    sh_binary(
        name = "verify_" + arch, srcs = ["verify.sh"], args = [arch],
        data = [":test_root_" + arch, "//:" + arch, "//scripts:verify_qemu_boot.py"],
    )
    for arch in ["arm64", "x86_64"]
]
