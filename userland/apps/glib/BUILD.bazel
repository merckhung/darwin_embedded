load("//userland/native/system:defs.bzl", "native_system")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])
[
    genrule(
        name = "dependencies_" + arch,
        srcs = ["build_dependencies.py", "build_intl.py", "//src/Applications/glib:sources",
                "//userland/native:sdk_" + arch,
                "//userland/native:mach.headers." + arch + ".tar", "//scripts:native_components.py"],
        outs = ["dependencies." + arch + ".tar", "dependencies." + arch + ".imports", "dependencies." + arch + ".json"],
        cmd = "python3 userland/apps/glib/build_dependencies.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --mach-headers $(location //userland/native:mach.headers." + arch + ".tar)" +
              " --output $(location dependencies." + arch + ".tar)" +
              " --imports $(location dependencies." + arch + ".imports)" +
              " --report $(location dependencies." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "dependencies", srcs = [":dependencies_arm64", ":dependencies_x86_64"])

[
    native_system(name = "system_" + arch, arch = arch, exports = ":dependencies." + arch + ".imports",
                  libraries = {"filesystem": "//userland/apps/x11:libnative_x11_support." + arch + ".a"})
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "closure", srcs = [":system_arm64", ":system_x86_64"])

[
    genrule(
        name = "runtime_" + arch,
        srcs = ["link_dependencies.py", "build_dependencies.py", "build_intl.py", "//userland/apps/x11:link_auth.py",
                "//scripts:native_components.py", "//scripts:sign_diagnostic_macho.py",
                "//src/Applications/glib:sources", ":dependencies." + arch + ".tar",
                ":system_" + arch + ".tar", "//userland/native:dyld_" + arch],
        outs = ["runtime." + arch + ".tar", "runtime." + arch + ".json"],
        cmd = "python3 userland/apps/glib/link_dependencies.py --root $$PWD --arch " + arch +
              " --libraries $(location :dependencies." + arch + ".tar) --system $(location :system_" + arch + ".tar)" +
              " --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --output $(location runtime." + arch + ".tar) --report $(location runtime." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "runtime", srcs = [":runtime_arm64", ":runtime_x86_64"])

sh_test(
    name = "artifact_test",
    size = "small",
    srcs = ["check_dependencies.sh"],
    data = ["check_dependencies.py", ":dependencies", ":runtime", "//src/Applications/glib:sources",
            "//userland/apps/x11:check_clients.py", "//userland/apps/x11:link_auth.py",
            "//userland/native:dyld_arm64", "//userland/native:dyld_x86_64"],
)

