load("//userland/native/system:defs.bzl", "native_system")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
package(default_visibility = ["//visibility:public"])
genrule(name = "empty_headers", outs = ["empty.tar"], cmd = "tar -cf $@ --files-from /dev/null")
[
    genrule(name = "objects_" + arch,
        srcs = ["build.py", "test_pty.c", "//userland/native:sdk_" + arch],
        outs = ["pty." + arch + ".o", "pty." + arch + ".imports"],
        cmd = "python3 $(location build.py) --arch " + arch + " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --source $(location test_pty.c) --output $(location pty." + arch + ".o) --requests $(location pty." + arch + ".imports)")
    for arch in ["arm64", "x86_64"]
]
[
    genrule(name = "requests_" + arch,
        srcs = [":pty." + arch + ".imports", "//userland/apps/init:system." + arch + ".exports"],
        outs = ["system." + arch + ".imports"], cmd = "cat $(SRCS) > $@")
    for arch in ["arm64", "x86_64"]
]
[
    native_system(name = "system_" + arch, arch = arch, exports = ":system." + arch + ".imports",
        libraries = {"accounts": "//userland/native/accounts:libaccounts." + arch + ".a",
                     "init_support": "//userland/apps/init:libinit_support." + arch + ".a"})
    for arch in ["arm64", "x86_64"]
]
[
    genrule(name = "runtime_report_" + arch,
        srcs = ["build.py", ":system_" + arch + ".tar"], outs = ["runtime." + arch + ".json"],
        cmd = "python3 $(location build.py) --arch " + arch + " --runtime $(location system_" + arch + ".tar) --output $@")
    for arch in ["arm64", "x86_64"]
]
[
    genrule(name = "root_" + arch,
        srcs = ["test_pty.c", ":empty_headers", ":system_" + arch + ".tar", ":runtime." + arch + ".json",
                "//userland/apps/init:root." + arch + ".img", "//userland/native:sdk_" + arch, "//userland/native:dyld_" + arch,
                "//userland/apps/x11:build_xorg_root.py", "//userland/apps/x11:link_auth.py", "//scripts:native_components.py",
                "//scripts:build_diagnostic_userland.py", "//scripts:sign_diagnostic_macho.py"],
        tools = ["//tools/libdmg-hfsplus:hfsplus"], outs = ["pty-root." + arch + ".img", "pty-root." + arch + ".json"],
        cmd = "python3 $(location //userland/apps/x11:build_xorg_root.py) --arch " + arch + " --probe-name native-pty-test" +
              " --probe-source $(location test_pty.c) --sdk $(location //userland/native:sdk_" + arch + ") --headers $(location empty_headers)" +
              " --runtime $(location system_" + arch + ".tar) --runtime-report $(location runtime." + arch + ".json)" +
              " --base-root $(location //userland/apps/init:root." + arch + ".img) --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --hfs-tool $(location //tools/libdmg-hfsplus:hfsplus) --output $(location pty-root." + arch + ".img) --report $(location pty-root." + arch + ".json)")
    for arch in ["arm64", "x86_64"]
]
[
    sh_binary(name = "verify_" + arch, srcs = ["verify.sh"], args = [arch],
        data = [":root_" + arch, "//:" + arch, "//scripts:verify_qemu_boot.py"])
    for arch in ["arm64", "x86_64"]
]
