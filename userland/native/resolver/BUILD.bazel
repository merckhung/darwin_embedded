load("//userland/native/system:defs.bzl", "native_system")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
package(default_visibility = ["//visibility:public"])
exports_files(["records.h"])
[
    genrule(
        name = "resolver_" + arch,
        srcs = ["build_resolver.py", "resolver.c", "records.h", "native_config.h", "//scripts:native_components.py",
                "//src/Applications/resolver:sources", "//src/Libraries/25.5.0:sources",
                "//src/Kernel/xnu/12377.121.6:sources",
                "//userland/native:sdk_" + arch],
        outs = ["libresolver." + arch + ".a", "resolver." + arch + ".json"],
        cmd = "python3 userland/native/resolver/build_resolver.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --output $(location libresolver." + arch + ".a) --report $(location resolver." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "libraries", srcs = [":resolver_arm64", ":resolver_x86_64"])
[
    native_system(name = "x11_system_" + arch, arch = arch,
                  exports = ":xlib.public." + arch + ".imports",
                  component_libraries = {"libc": ["//userland/apps/x11:libnative_x11_libc." + arch + ".a"]},
                  libraries = {
                      "resolver": ":libresolver." + arch + ".a",
                      "accounts": "//userland/native/accounts:libaccounts." + arch + ".a",
                      "x11_support": "//userland/apps/x11:libnative_x11_support." + arch + ".a",
                  })
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "x11_closure", srcs = [":x11_system_arm64", ":x11_system_x86_64"])

[
    genrule(
        name = "public_requests_" + arch,
        srcs = ["public_requests.py", "//scripts:native_components.py",
                "//userland/apps/x11:xlib." + arch + ".imports",
                "//userland/native/libc:libc_base." + arch + ".a"],
        outs = ["xlib.public." + arch + ".imports", "xlib.private." + arch + ".json"],
        cmd = "python3 userland/native/resolver/public_requests.py" +
              " --input $(location //userland/apps/x11:xlib." + arch + ".imports)" +
              " --libc $(location //userland/native/libc:libc_base." + arch + ".a)" +
              " --output $(location xlib.public." + arch + ".imports)" +
              " --report $(location xlib.private." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

[
    genrule(
        name = "test_probe_" + arch,
        srcs = ["build_test.py", "test_resolver.c", "test_x11.c",
                ":client-runtime." + arch + ".json", ":xlib.public." + arch + ".imports",
                "//userland/apps/x11:xlib." + arch + ".tar", "//scripts:native_components.py",
                "//scripts:build_diagnostic_userland.py", "//scripts:sign_diagnostic_macho.py",
                "//userland/native:sdk_" + arch],
        outs = ["test_resolver." + arch + ".a", "test_resolver." + arch + ".imports", "test_resolver." + arch + ".json"],
        cmd = "python3 userland/native/resolver/build_test.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --headers $(location //userland/apps/x11:xlib." + arch + ".tar)" +
              " --client-report $(location :client-runtime." + arch + ".json)" +
              " --native-requests $(location :xlib.public." + arch + ".imports)" +
              " --output $(location test_resolver." + arch + ".a) --exports $(location test_resolver." + arch + ".imports)" +
              " --report $(location test_resolver." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]

[
    native_system(name = "test_system_" + arch, arch = arch,
                  exports = ":test_resolver." + arch + ".imports",
                  libraries = {"resolver": ":libresolver." + arch + ".a",
                               "accounts": "//userland/native/accounts:libaccounts." + arch + ".a",
                               "x11_support": "//userland/apps/x11:libnative_x11_support." + arch + ".a"},
                  component_libraries = {"libc": ["//userland/apps/x11:libnative_x11_libc." + arch + ".a"]})
    for arch in ["arm64", "x86_64"]
]

[
    genrule(
        name = "test_root_" + arch,
        srcs = ["build_test.py", ":test_resolver." + arch + ".a", ":test_system_" + arch + ".tar",
                ":client-runtime." + arch + ".tar",
                "//scripts:native_components.py", "//scripts:build_diagnostic_userland.py",
                "//scripts:sign_diagnostic_macho.py", "//userland/native:sdk_" + arch,
                "//userland/native:dyld_" + arch, "//userland/diagnostic:root_" + arch],
        tools = ["//tools/libdmg-hfsplus:hfsplus"],
        outs = ["resolver-test-root." + arch + ".img", "resolver-test-root." + arch + ".json"],
        cmd = "python3 userland/native/resolver/build_test.py --root $$PWD --arch " + arch +
              " --sdk $(location //userland/native:sdk_" + arch + ")" +
              " --clients $(location :client-runtime." + arch + ".tar)" +
              " --probe $(location :test_resolver." + arch + ".a) --system $(location :test_system_" + arch + ".tar)" +
              " --base-root $(location //userland/diagnostic:root_" + arch + ")" +
              " --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --hfs-tool $(location //tools/libdmg-hfsplus:hfsplus)" +
              " --output $(location resolver-test-root." + arch + ".img) --report $(location resolver-test-root." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "test_roots", srcs = [":test_root_arm64", ":test_root_x86_64"])

[
    sh_binary(
        name = "verify_" + arch,
        srcs = ["verify.sh"], args = [arch],
        data = [":test_root_" + arch, "//:" + arch, "//scripts:verify_qemu_boot.py"],
    )
    for arch in ["arm64", "x86_64"]
]

sh_test(
    name = "artifact_test", size = "small", srcs = ["test_artifacts.sh"],
    data = ["test_artifacts.py", ":libraries", ":x11_closure", ":client_runtime",
            ":test_system_arm64", ":test_system_x86_64",
            "//userland/apps/x11:link_auth.py", "//userland/apps/x11:check_clients.py",
            "//userland/native:dyld_arm64", "//userland/native:dyld_x86_64",
            "//src/Applications/resolver:sources", "//scripts:build_native_system.py",
            "//scripts:native_components.py", "//scripts:sign_diagnostic_macho.py"],
)

[
    genrule(
        name = "clients_" + arch,
        srcs = ["link_clients.py", "//userland/apps/x11:build_clients.py", "//userland/apps/x11:link_auth.py",
                "//scripts:native_components.py", "//scripts:sign_diagnostic_macho.py", "//src/Applications/x11:sources",
                "//userland/apps/x11:xlib." + arch + ".tar", ":x11_system_" + arch + ".tar", "//userland/native:dyld_" + arch],
        outs = ["client-runtime." + arch + ".tar", "client-runtime." + arch + ".json"],
        cmd = "python3 userland/native/resolver/link_clients.py --root $$PWD --arch " + arch +
              " --clients $(location //userland/apps/x11:xlib." + arch + ".tar)" +
              " --system $(location :x11_system_" + arch + ".tar) --dyld $(location //userland/native:dyld_" + arch + ")" +
              " --output $(location client-runtime." + arch + ".tar) --report $(location client-runtime." + arch + ".json)",
    )
    for arch in ["arm64", "x86_64"]
]
filegroup(name = "client_runtime", srcs = [":clients_arm64", ":clients_x86_64"])
