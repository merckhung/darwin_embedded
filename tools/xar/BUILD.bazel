load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "host_libxar",
    srcs = [
        "lib/archive.c",
        "lib/arcmod.c",
        "lib/b64.c",
        "lib/bzxar.c",
        "lib/darwinattr.c",
        "lib/data.c",
        "lib/ea.c",
        "lib/err.c",
        "lib/ext2.c",
        "lib/fbsdattr.c",
        "lib/filetree.c",
        "lib/hash.c",
        "lib/io.c",
        "lib/linuxattr.c",
        "lib/lzmaxar.c",
        "lib/macho.c",
        "lib/script.c",
        "lib/signature.c",
        "lib/stat.c",
        "lib/subdoc.c",
        "lib/util.c",
        "lib/zxar.c",
        "lib/strmode.h",
    ],
    hdrs = glob(["lib/*.h"]) + ["include/xar.h"],
    copts = [
        "-D_GNU_SOURCE",
        "-DHAVE_CONFIG_H",
        "-I/usr/include/libxml2",
    ],
    includes = ["include", "lib"],
    deps = [
        "//:sys_zlib",
        "//:sys_libxml2",
        "//:sys_crypto",
        "//:sys_ssl",
    ],
    linkstatic = 1,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "xar",
    srcs = ["src/xar.c"],
    copts = ["-I/usr/include/libxml2"],
    deps = [":host_libxar"],
    visibility = ["//visibility:public"],
)
