load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "dtrace_ctf_lib",
    srcs = glob([
        "libctf/*.c",
        "libdwarf/*.c",
        "libelf/*.c",
        "tools/*.c",
        "tools/*.cpp",
    ], exclude = [
        "tools/ctfconvert.c",
        "tools/ctfmerge.c",
        "libelf/clscook.c",
        "libelf/elf_macho_stubs.c",
    ]),
    hdrs = glob([
        "include/**/*.h",
        "libctf/*.h",
        "libdwarf/*.h",
        "libelf/*.h",
        "tools/*.h",
        "libelf/clscook.c",
    ]),
    defines = [
        "linux",
        "_GNU_SOURCE",
        "__APPLE__",
        "__LITTLE_ENDIAN__",
        "CTF_OLD_VERSIONS",
        "__private_extern__=",
    ],
    copts = [
        "-Wno-implicit-function-declaration",
        "-Wno-format",
    ],
    includes = ["include", "include/sys", "libctf", "libdwarf", "libelf", "tools"],
    deps = [
        "//tools/cctools:foreign_includes",
        "//tools/cctools:libstuff",
        "//:sys_zlib",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "barrier_test",
    srcs = ["tests/barrier_test.c", "tools/barrier.c", "tools/barrier.h"],
    defines = ["_GNU_SOURCE"],
    includes = ["tools"],
    linkopts = ["-pthread"],
)

cc_binary(
    name = "ctfconvert",
    srcs = ["tools/ctfconvert.c"],
    deps = [":dtrace_ctf_lib"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "ctfmerge",
    srcs = ["tools/ctfmerge.c"],
    deps = [":dtrace_ctf_lib"],
    visibility = ["//visibility:public"],
)
