load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_binary(
    name = "kc-builder",
    srcs = ["src/kc_builder.c", "src/fileset.c"] + glob(["lib/*.c", "include/*.h"]),
    includes = ["include"],
    copts = ["-std=gnu11", "-Wno-unused-function", "-Wno-unused-variable"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "view_test",
    size = "small",
    srcs = ["tests/view_test.c", "lib/macho_view.c"] + glob(["include/*.h"]),
    includes = ["include"],
)
