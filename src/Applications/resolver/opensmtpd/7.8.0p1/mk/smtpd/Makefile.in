@SET_MAKE@

# In OpenBSD, smtpd's files are installed this way:
#
# /etc/mail/smtpd.conf
# /usr/sbin/smtpd
#
#
# For OpenSMTPD portable, here's where files are installed:
# (assuming PREFIX=/usr/local)
#
# /usr/local/etc/smtpd.conf
# /usr/local/sbin/smtpd

